# Keep the build context small and prevent local state or secrets from
# being copied into the image.

.git/
.gitignore
__pycache__/
*.py[cod]
*.egg-info/

# Local runtime state - must not be baked into the image
.tmp/
logs/
*.log

# Node / frontend workspace (the served UI is plain HTML/CSS/JS in web/)
node_modules/
frontend/node_modules/
dist/

# Secrets and local env
.env
.env.*
!.env.example

# Editors and OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db

# Docs and screenshots not needed at runtime
UI Screenshots/
*.md
!README.md
